<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="paste_download"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/app_name"
        android:shortcutLongLabel="@string/shortcut_paste">
        <intent
            android:action="com.example.yt2mp3.action.PASTE_DOWNLOAD"
            android:targetPackage="com.example.yt2mp3"
            android:targetClass="com.example.yt2mp3.MainActivity" />
        <categories android:name="android.shortcut.category productivity" />
    </shortcut>
    <shortcut
        android:shortcutId="open_app"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_open"
        android:shortcutLongLabel="@string/shortcut_open">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.example.yt2mp3"
            android:targetClass="com.example.yt2mp3.MainActivity" />
    </shortcut>
</shortcuts>
